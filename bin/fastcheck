#!/bin/sh

set -e

if ! bundle exec standardrb --fail-fast
then
  echo 'StandardRB detected issues!'
  bundle exec standardrb --fix
  echo 'Tried to auto-correct the issues, but they must be reviewed manually. Commit aborted.'
  exit 1
fi

if ! bundle exec erb_lint --lint-all
then
  echo 'erb_lint detected issues!'
  bundle exec erb_lint --lint-all --autocorrect
  echo 'Tried to auto correct the issues, but must be reviewed manually, commit aborted'
  exit 1
fi

# format
npx prettier . --write

# for css
npx stylelint "./app/assets/stylesheets/**/*.css"

# for javascript
npx eslint app/javascript
